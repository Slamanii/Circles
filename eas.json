{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "node": "22.12.0"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "environment": "preview",
      "node": "22.12.0"
    },
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      },
      "channel": "simulator",
      "environment": "preview",
      "node": "22.12.0"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "node": "22.12.0"
    }
  },
  "submit": {
    "production": {}
  }
}
