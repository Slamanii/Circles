{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@solana/spl-account-compression": ["./node_modules/@solana/spl-account-compression/dist/types/src/index.d.ts"],
      "@src/*": ["../src/*"],

    }
  },
  "include": ["src/**/*"]

}